    {
      "name": "2. Tareas (CRUD)",
      "item": [
        {
          "name": "Crear → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Estudiar Node {{$timestamp}}\",\n  \"description\": \"Unidad 2\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set('taskId', t.id);",
                  "pm.collectionVariables.set('taskTitle', t.title);",
                  "pm.collectionVariables.set('version', t.version);"
                ]
              }
            }
          ]
        },
